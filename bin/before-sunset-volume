#!/bin/bash

# Ease the output volume to a target percentage over a few seconds.
#
# The sink is resolved through omarchy-audio-output-sink, the same helper the
# volume keys and the audio panel use, so a DSP or combined sink in front of the
# hardware is honoured rather than bypassed. pactl reads and writes the same
# percentage scale those keys report.
#
# Deliberately silent: no OSD. A twenty-second ramp through the normal volume
# command would flash the on-screen display dozens of times for something the
# user did not press a key to do.
#
# Usage: before-sunset-volume <target-percent> [fade-seconds] [down|up]
#
#   down  act only if the volume is above the target (the night case: quieter,
#         never louder, so a deliberately hushed machine is left alone)
#   up    act only if it is below (the morning counterpart)
#   both  ease either way

set -uo pipefail

target=${1:-}
fade=${2:-20}
direction=${3:-both}

[[ $target =~ ^[0-9]+$ ]] || { echo "usage: before-sunset-volume <target-percent> [fade-seconds] [down|up|both]" >&2; exit 1; }
((target <= 100)) || target=100
[[ $fade =~ ^[0-9]+$ ]] || fade=20

sink=$(omarchy-audio-output-sink 2>/dev/null)
[[ -n $sink ]] || { echo "no audio sink to control" >&2; exit 1; }

read_percent() {
  pactl get-sink-volume "$sink" 2>/dev/null |
    awk 'NR == 1 {
      for (i = 1; i <= NF; i++)
        if ($i ~ /%$/) { sub("%", "", $i); print $i; exit }
    }'
}

current=$(read_percent)
[[ $current =~ ^[0-9]+$ ]] || { echo "could not read the volume for $sink" >&2; exit 1; }

case "$direction" in
down) ((current > target)) || exit 0 ;;
up) ((current < target)) || exit 0 ;;
esac

((current != target)) || exit 0

# ------------------------------------------------------------------- locking

# A lock no other user can reach, that is never signalled.
#
# The old shape was a PID written to a predictable path under /tmp whenever
# XDG_RUNTIME_DIR was unset. Two things were wrong with that, and neither is
# worth arguing about: another local user can create that name first, and the
# contents were trusted well enough to be handed to kill. The second half
# survives even where the kernel's protected_symlinks and protected_regular
# stop the first, because those guard writing to somebody else's file, not
# reading it — a planted PID would still have been signalled.
#
# So: the directory is owner-only, and nothing is signalled at all. Replacing a
# running fade is cooperative. The newcomer writes its own token into the lock;
# the incumbent re-reads the file every step, finds a token that is not its own,
# and stands down by itself. No PID is trusted because no PID is used.

lock=""
token=""

runtime_directory() {
  local dir=${XDG_RUNTIME_DIR:-}

  # The session's own runtime directory is already 0700 and ours. Anything else
  # has to be made that way before it can be used, and a symlink standing where
  # the directory should be is refused rather than followed.
  if [[ -n $dir && ! -L $dir && -d $dir && -O $dir ]]; then
    printf '%s\n' "$dir"
    return 0
  fi

  dir="/tmp/before-sunset-$(id -u)"
  [[ -L $dir ]] && return 1
  mkdir -m 700 -p "$dir" 2>/dev/null || return 1
  [[ ! -L $dir && -d $dir && -O $dir ]] || return 1
  # A directory that already existed keeps the mode it had, which may not be
  # the one we asked for.
  chmod 700 "$dir" 2>/dev/null || return 1

  printf '%s\n' "$dir"
}

claim_lock() {
  local dir
  dir=$(runtime_directory) || return 1

  lock="$dir/$1"
  token="$$.$(date +%s%N)"
  printf '%s\n' "$token" >"$lock" 2>/dev/null || { lock=""; return 1; }

  # Long enough for an incumbent to reach its next step and see the new token.
  sleep 0.25
}

# True when nobody has taken the lock from us. Also true when there is no lock
# at all: a machine where the directory cannot be secured runs without the
# serialising, which is worse behaviour but not less safe behaviour.
holds_lock() {
  [[ -n $lock ]] || return 0
  [[ $(cat "$lock" 2>/dev/null) == "$token" ]]
}

release_lock() {
  [[ -n $lock ]] || return 0
  holds_lock && rm -f "$lock"
  lock=""
}

# One fade at a time. A day transition landing on top of a night fade should
# replace it, not race it.
claim_lock "volume.lock"
trap release_lock EXIT INT TERM

# Roughly four steps a second: fine enough to hear as a slide rather than a
# staircase, coarse enough not to spam the sound server.
steps=$((fade * 4))
((steps > 0)) || steps=1
((steps <= 200)) || steps=200

expected=$current

for ((i = 1; i <= steps; i++)); do
  # A newer fade has taken the lock: it is on its way to the same speakers with
  # a fresher opinion, so this one stands down.
  holds_lock || exit 0

  # Someone reaching for the volume keys mid-fade means they have an opinion
  # about the volume, which outranks the schedule's. Stop rather than fight.
  actual=$(read_percent)
  if [[ $actual =~ ^[0-9]+$ ]]; then
    difference=$((actual > expected ? actual - expected : expected - actual))
    ((difference <= 1)) || exit 0
  fi

  next=$((current + (target - current) * i / steps))
  pactl set-sink-volume "$sink" "${next}%" 2>/dev/null || exit 1
  expected=$next

  ((i < steps)) && sleep 0.25
done
