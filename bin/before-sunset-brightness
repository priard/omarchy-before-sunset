#!/bin/bash

# List the displays whose brightness can be driven, or set one of them.
#
# Three kinds of display answer to three different mechanisms, and Omarchy
# already knows which is which — `omarchy-brightness-display` picks between the
# internal panel's backlight, DDC/CI over i2c, and asdcontrol for Apple's
# displays. This goes through that command for the first two.
#
# The Apple case is driven directly, for the same reason the night light drives
# hyprsunset rather than omarchy-toggle-nightlight: the command cannot do what
# is needed here. `omarchy-brightness-display --monitor DP-2` takes the monitor
# name, hands it to omarchy-brightness-display-apple, and that helper ignores it
# — it drives whichever hiddev device it detected first. With two Studio
# Displays connected, every write lands on the same panel and the other never
# moves. Addressing the devices ourselves is the only way both of them dim.
#
# Which device is which monitor, though, is not knowable: a display's EDID
# serial (0x7F572A18) and its USB serial (00008030-001D196826F8802E) have
# nothing in common. So Apple displays are targets in their own right rather
# than being tied to a connector, and the caller is expected to say so.
#
# Usage:
#   before-sunset-brightness                       list targets as JSON
#   before-sunset-brightness <id> <percent> [down|up|both]
#   before-sunset-brightness --ramp <seconds> <down|up> <id> <percent>...
#
#   down  act only if the display is brighter than the target (the dusk case)
#   up    act only if it is dimmer (the dawn one)
#   both  move it either way
#
# Output of the listing:
#   {"targets":[{"id","kind","label","monitor","value"}]}
#
# ids are stable across a reboot and a replug: an EDID serial for a monitor, a
# USB serial for an Apple display. The connector name is reported too, because
# that is what the write needs, but it is never the identity — DP-1 becomes
# DP-2 the moment two cables change places.

set -uo pipefail

# Never leave a screen too dark to find the setting that did it. DDC clamps to
# 1% on its own, which is close enough to off to frighten someone.
FLOOR=5

apple_devices() {
  local paths=()
  local path

  for path in /dev/usb/hiddev* /dev/hiddev*; do
    [[ -e $path ]] && paths+=("$path")
  done

  ((${#paths[@]} > 0)) || return 0

  # --detect prints one SUPPORTED line per Apple display it can drive; every
  # other hiddev on the machine (keyboards, the odd docking station) is quiet.
  sudo -n asdcontrol --detect "${paths[@]}" 2>/dev/null |
    awk -F: '/USB Monitor.*SUPPORTED/ { print $1 }'
}

usb_serial() {
  local dir
  dir=$(udevadm info -q path -n "$1" 2>/dev/null) || return 1
  dir="/sys$dir"

  # The serial lives on the USB device, several levels above the hiddev node.
  while [[ $dir != / && ! -r $dir/serial ]]; do dir=$(dirname "$dir"); done
  [[ -r $dir/serial ]] || return 1
  cat "$dir/serial"
}

apple_percent() {
  # asdcontrol reports the raw value out of 60000, the same scale it takes.
  sudo -n asdcontrol "$1" 2>/dev/null |
    awk -F= '/BRIGHTNESS=/ { print int($2 * 100 / 60000); found = 1; exit } END { exit !found }'
}

monitors_json() {
  hyprctl -j monitors 2>/dev/null | jq -c '[.[] | select(.disabled != true)]' 2>/dev/null
}

# ------------------------------------------------------------------ listing

list_targets() {
  local monitors entries=()
  monitors=$(monitors_json)
  [[ -n $monitors ]] || monitors='[]'

  local name serial description model make internal_seen=0

  while IFS=$'\t' read -r name description make model serial; do
    [[ -n $name ]] || continue

    if [[ $name =~ ^(eDP|LVDS|DSI)- ]]; then
      # One backlight, however many internal panels a machine claims: the
      # kernel exposes a single device and Omarchy picks it.
      ((internal_seen)) && continue
      internal_seen=1

      local value
      value=$(omarchy-brightness-display --monitor "$name" 2>/dev/null)
      [[ $value =~ ^[0-9]+$ ]] || continue

      entries+=("$(jq -nc --arg id "panel" --arg kind "backlight" \
        --arg label "${description:-$name}" --arg monitor "$name" --argjson value "$value" \
        '{$id, $kind, $label, $monitor, $value}')")
      continue
    fi

    # Apple displays are enumerated by device below; listing them here as well
    # would offer the same panel twice under two different ids.
    if [[ $make == "Apple Computer Inc" && $model =~ (StudioDisplay|ProDisplayXDR|Studio\ XDR) ]]; then
      continue
    fi

    # The read is the capability test. A monitor with no DDC, or one whose
    # firmware refuses the brightness code, simply says nothing and is left out
    # of the list rather than being reported as broken.
    local value
    value=$(omarchy-brightness-display-ddc "$name" 2>/dev/null)
    [[ $value =~ ^[0-9]+$ ]] || continue

    local id="$serial"
    [[ -n $id && $id != "null" ]] || id="$name"

    entries+=("$(jq -nc --arg id "ddc:$id" --arg kind "ddc" \
      --arg label "${description:-$name}" --arg monitor "$name" --argjson value "$value" \
      '{$id, $kind, $label, $monitor, $value}')")
  done < <(printf '%s' "$monitors" | jq -r '.[] | [.name, .description, .make, .model, .serial] | @tsv')

  local device serial percent
  while read -r device; do
    [[ -n $device ]] || continue
    serial=$(usb_serial "$device") || continue
    percent=$(apple_percent "$device") || continue

    entries+=("$(jq -nc --arg id "apple:$serial" --arg kind "apple" \
      --arg label "Apple Studio Display" --arg monitor "" --argjson value "$percent" \
      '{$id, $kind, $label, $monitor, $value}')")
  done < <(apple_devices)

  if ((${#entries[@]} == 0)); then
    jq -n '{targets: []}'
    return 0
  fi

  printf '%s\n' "${entries[@]}" | jq -sc '{targets: .}'
}

# ------------------------------------------------------------------ setting

resolve_monitor() {
  # An id outlives the connector it was seen on, so the name is looked up fresh
  # every time rather than remembered.
  local wanted=$1 monitors
  monitors=$(monitors_json)
  [[ -n $monitors ]] || return 1

  printf '%s' "$monitors" |
    jq -r --arg wanted "$wanted" '
      (.[] | select(.serial == $wanted) | .name),
      (.[] | select(.name == $wanted) | .name)
    ' 2>/dev/null | head -n1
}

resolve_apple_device() {
  local wanted=$1 device serial

  while read -r device; do
    [[ -n $device ]] || continue
    serial=$(usb_serial "$device") || continue
    if [[ $serial == "$wanted" ]]; then
      printf '%s\n' "$device"
      return 0
    fi
  done < <(apple_devices)

  return 1
}

internal_monitor() {
  monitors_json | jq -r '.[] | select(.name | test("^(eDP|LVDS|DSI)-")) | .name' | head -n1
}

read_percent() {
  local id=$1 monitor device

  case "$id" in
  panel)
    monitor=$(internal_monitor)
    [[ -n $monitor ]] || return 1
    omarchy-brightness-display --monitor "$monitor" 2>/dev/null
    ;;
  ddc:*)
    monitor=$(resolve_monitor "${id#ddc:}") || return 1
    [[ -n $monitor ]] || return 1
    omarchy-brightness-display-ddc "$monitor" 2>/dev/null
    ;;
  apple:*)
    device=$(resolve_apple_device "${id#apple:}") || return 1
    apple_percent "$device"
    ;;
  *)
    return 1
    ;;
  esac
}

write_percent() {
  local id=$1 target=$2 monitor device

  case "$id" in
  panel)
    monitor=$(internal_monitor)
    [[ -n $monitor ]] || return 1
    ;;
  ddc:*)
    monitor=$(resolve_monitor "${id#ddc:}") || return 1
    [[ -n $monitor ]] || return 1
    ;;
  apple:*)
    device=$(resolve_apple_device "${id#apple:}") || return 1
    sudo -n asdcontrol "$device" -- "${target}%" >/dev/null 2>&1
    return
    ;;
  *)
    return 1
    ;;
  esac

  omarchy-brightness-display --no-osd --monitor "$monitor" "${target}%" >/dev/null 2>&1
}

set_target() {
  local id=$1 target=$2 direction=$3 current

  current=$(read_percent "$id") || return 1
  [[ $current =~ ^[0-9]+$ ]] || return 1

  # The whole point of the direction: dusk may only darken and dawn may only
  # brighten, so a screen someone has already turned down for their own reasons
  # is left where they put it.
  case "$direction" in
  down) ((current > target)) || return 0 ;;
  up) ((current < target)) || return 0 ;;
  esac

  ((current != target)) || return 0

  write_percent "$id" "$target"
}

# --------------------------------------------------------------------- ramp

# A hardware brightness change is a step: DDC and asdcontrol take one value and
# the screen is simply at it. Stepping the whole desktop at dusk is exactly the
# thing this plugin exists not to do — but writing a hundred intermediate values
# is worse. DDC brightness lives in the monitor's own memory, and some panels
# have a finite number of writes in them; a ramp per turn, twice a day, for
# years, is not a thing to spend them on.
#
# So the ramp happens in software and the hardware moves once. hyprsunset holds
# a gamma table for every output and takes a percentage over the same hyprctl
# socket the night light already uses, which costs about four milliseconds and
# nothing at all in the monitor.
#
#   Dusk:  gamma slides 100% down to target/current, and at the bottom the
#          hardware takes the real value while gamma goes back to 100%.
#   Dawn:  gamma drops to current/target and the hardware takes the real value
#          in the same breath — the two cancel, so nothing jumps — and then
#          gamma slides back up to 100%.
#
# Both swaps are ordered so the gap between the two writes reads as a momentary
# dip rather than a flash. A screen that darkens for a frame is missable; a
# screen that flares is not.
#
# Gamma is global — hyprsunset holds one table for the whole session, with no
# per-output switch in 0.4.0 — so with several displays the slide follows the
# shallowest of them. Nothing is ever darker on the way than it will be at the
# end, and the deeper targets finish their fall in the hardware step, which is
# the direction they were going anyway.

GAMMA_FLOOR=5

gamma_read() {
  hyprctl hyprsunset gamma 2>/dev/null | grep -oE '^[0-9]+' | head -n1
}

gamma_write() {
  hyprctl hyprsunset gamma "$1" >/dev/null 2>&1
}

# What we last wrote, so our own dim can be told from somebody else's.
owned_gamma=-1

# Global, because the EXIT trap reads it after the frame that would have held it
# is gone — and under `set -u` an unset name there takes the trap down with it,
# which is precisely when the screen is still dimmed.
lock="${XDG_RUNTIME_DIR:-/tmp}/before-sunset-brightness.pid"

release_gamma() {
  ((owned_gamma >= 0)) || return 0

  local now
  now=$(gamma_read)
  owned_gamma_was=$owned_gamma
  owned_gamma=-1

  # Only put it back if it is still where we left it. Anyone else driving gamma
  # now owns it, and stamping 100 over their setting on the way out would be the
  # rudest possible exit.
  [[ $now =~ ^[0-9]+$ ]] || return 0
  ((now >= owned_gamma_was - 3 && now <= owned_gamma_was + 3)) || return 0

  gamma_write 100
}

ramp_ids=()
ramp_targets=()
ramp_currents=()

# 0 finished, 1 gamma taken by somebody else, 2 a display moved under us.
#
# Driven by the clock rather than by a step count. Every step costs a hyprctl
# round trip, and reading two displays back over USB costs several more, so a
# fixed sleep per step made a four-second fade take eight. The value is
# interpolated from how much of the window has actually gone, which means a slow
# machine draws the same slide in fewer stops rather than taking twice as long
# over it.
fade_gamma() {
  local from=$1 to=$2 seconds=$3
  local started now elapsed span value seen index
  local last=$from ticks=0

  span=$((seconds * 1000000000))
  ((span > 0)) || span=1
  started=$(date +%s%N)

  while :; do
    now=$(date +%s%N)
    elapsed=$((now - started))
    ((elapsed < span)) || break

    value=$((from + (to - from) * elapsed / span))
    if ((value != last)); then
      gamma_write "$value"
      owned_gamma=$value
      last=$value
    fi

    sleep 0.2
    ((ticks++))

    # Both checks cost a round trip, so neither runs every tick. Gamma is asked
    # about once a second; the displays every two, because someone reaching for
    # the brightness keys is not going to do it faster than that, and asking
    # them over USB four times a second would cost more than the ramp.
    if ((ticks % 5 == 0)); then
      seen=$(gamma_read)
      if [[ $seen =~ ^[0-9]+$ ]] && ((seen < last - 3 || seen > last + 3)); then
        owned_gamma=-1
        return 1
      fi
    fi

    if ((ticks % 10 == 0)); then
      for index in "${!ramp_ids[@]}"; do
        seen=$(read_percent "${ramp_ids[$index]}") || continue
        [[ $seen =~ ^[0-9]+$ ]] || continue
        if ((seen < ramp_currents[index] - 2 || seen > ramp_currents[index] + 2)); then
          return 2
        fi
      done
    fi
  done

  gamma_write "$to"
  owned_gamma=$to
  return 0
}

land_hardware() {
  local index
  for index in "${!ramp_ids[@]}"; do
    write_percent "${ramp_ids[$index]}" "${ramp_targets[$index]}"
  done
}

ramp() {
  local seconds=$1 direction=$2
  shift 2

  local id want current
  while (($# >= 2)); do
    id=$1
    want=$2
    shift 2

    [[ $want =~ ^[0-9]+$ ]] || continue
    ((want >= FLOOR)) || want=$FLOOR
    ((want <= 100)) || want=100

    current=$(read_percent "$id") || continue
    [[ $current =~ ^[0-9]+$ ]] || continue

    case "$direction" in
    down) ((current > want)) || continue ;;
    up) ((current < want)) || continue ;;
    esac

    ramp_ids+=("$id")
    ramp_targets+=("$want")
    ramp_currents+=("$current")
  done

  ((${#ramp_ids[@]} > 0)) || return 0

  # One ramp at a time. A dawn arriving on top of a dusk should replace it, not
  # race it across the same gamma table.
  if [[ -r $lock ]]; then
    local previous
    previous=$(cat "$lock" 2>/dev/null)
    if [[ $previous =~ ^[0-9]+$ ]] && kill -0 "$previous" 2>/dev/null; then
      kill "$previous" 2>/dev/null
      # Let its own exit put gamma back before we read it, or we would take its
      # half-finished dim for the resting state and ramp from there.
      local waited=0
      while kill -0 "$previous" 2>/dev/null && ((waited < 20)); do
        sleep 0.1
        ((waited++))
      done
      sleep 0.2
    fi
  fi
  echo $$ >"$lock"

  local index ratio gamma=0
  for index in "${!ramp_ids[@]}"; do
    if [[ $direction == up ]]; then
      ratio=$((ramp_currents[index] * 100 / ramp_targets[index]))
    else
      ratio=$((ramp_targets[index] * 100 / ramp_currents[index]))
    fi
    ((ratio < GAMMA_FLOOR)) && ratio=$GAMMA_FLOOR
    ((ratio > 100)) && ratio=100
    ((ratio > gamma)) && gamma=$ratio
  done

  local resting
  resting=$(gamma_read)

  # No ramp is possible, or none is worth doing: no hyprsunset behind the
  # socket, gamma already held below full by something else, or a slide too
  # shallow to see. The step is still owed either way.
  if ((seconds <= 0)) || ((gamma >= 98)) ||
    [[ ! $resting =~ ^[0-9]+$ ]] || ((resting < 98)); then
    land_hardware
    rm -f "$lock"
    return 0
  fi

  trap 'release_gamma; rm -f "$lock"' EXIT INT TERM

  if [[ $direction == down ]]; then
    fade_gamma 100 "$gamma" "$seconds"
    case $? in
    2) return 0 ;;
    esac
    land_hardware
    release_gamma
  else
    owned_gamma=$gamma
    gamma_write "$gamma"
    land_hardware
    fade_gamma "$gamma" 100 "$seconds"
    ((owned_gamma < 0)) || { gamma_write 100; owned_gamma=-1; }
  fi
}

# -------------------------------------------------------------------- entry

if (($# == 0)); then
  list_targets
  exit 0
fi

if [[ $1 == "--ramp" ]]; then
  shift
  (($# >= 4)) || {
    echo "usage: before-sunset-brightness --ramp <seconds> <down|up> <id> <percent>..." >&2
    exit 1
  }
  seconds=$1
  direction=$2
  shift 2
  [[ $seconds =~ ^[0-9]+$ ]] || seconds=0
  ramp "$seconds" "$direction" "$@"
  exit 0
fi

(($# >= 2)) || {
  echo "usage: before-sunset-brightness [<id> <percent> [down|up|both]]" >&2
  exit 1
}

id=$1
target=$2
direction=${3:-both}

[[ $target =~ ^[0-9]+$ ]] || {
  echo "usage: before-sunset-brightness [<id> <percent> [down|up|both]]" >&2
  exit 1
}

((target >= FLOOR)) || target=$FLOOR
((target <= 100)) || target=100

set_target "$id" "$target" "$direction"
